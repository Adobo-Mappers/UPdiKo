# Your Supabase project URL
VITE_SUPABASE_URL=your_api_goes_here             

# Your Supabase anonymous key
VITE_SUPABASE_ANON_KEY=your_api_goes_here      

# Server-side Supabase project URL. This usually matches VITE_SUPABASE_URL.
SUPABASE_URL=your_api_goes_here

# Server-side key for backend-only database lookups. Never expose this in VITE_* vars.
SUPABASE_SERVICE_ROLE_KEY=your_api_goes_here

# Your Stadia Maps API key (required for map tiles and to avoid rate-limiting)   
VITE_STADIA_API_KEY=your_api_goes_here        

# Open-Meteo forecast URL for Miagao (optional, enables weather card)   
VITE_OPENMETEO_API_URL=your_api_goes_here   

# Your Google Gemini API key (server-side only)
GEMINI_API_KEY=your_api_goes_here

# Optional comma-separated server-side Gemini fallback list.
GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash

# Base URL for the API backend. Leave empty when frontend and backend
# share the same origin (e.g., on Vercel). Set to the full backend URL
# when the backend is hosted separately (e.g., http://localhost:3000).
VITE_API_BASE=

# Production origins allowed for CORS (server-side only).
# Example: https://updiko.vercel.app
CORS_ORIGIN=
