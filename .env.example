# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Gemini AI (server-side only — never expose in client)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Optional: backend base URL (leave empty to use Vite proxy in dev)
VITE_API_BASE=

# Server
PORT=3000
